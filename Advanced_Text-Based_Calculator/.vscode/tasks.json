{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build Clang",
			"type": "shell",
			"command": "clang",
			"args": [
				"-fcolor-diagnostics",
				"-fansi-escape-codes",
				"-g",
				"${workspaceFolder}/src/main.c",
				"${workspaceFolder}/src/arithmetic.c",
				"-o",
				"${workspaceFolder}/src/build_clang/advanced_calculator.exe"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": "build",
			"detail": "compiler: C:\\mingw64LLVM_Clang_LLD_LLDB\\bin\\clang.exe"
		},
		{
			"label": "Run Clang",
			"type": "shell",
			"command": "${workspaceFolder}/src/build_clang/advanced_calculator.exe",
			"group": {
				"kind": "test",
				"isDefault": true
			}
		}
	]
}