{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Clang Executable",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/src/build_clang/advanced_calculator.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/src/build_clang",
            "environment": [],
            "externalConsole": true,
            "MIMode": "gdb",
            "miDebuggerPath": "C:\\mingw64LLVM_Clang_LLD_LLDB\\bin\\gdb.exe",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Build Clang"
        }
    ]
}