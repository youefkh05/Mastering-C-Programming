{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "cppbuild",
			"label": "Clang build",
			"command": "C:\\mingw64LLVM_Clang_LLD_LLDB\\bin\\clang.exe",
			"args": [
				"-fcolor-diagnostics",
				"-fansi-escape-codes",
				"-g",
				"${workspaceFolder}/src/main.c",
				"${workspaceFolder}/src/include/Stack/StackArrayDS.c",
				"-I",
				"${workspaceFolder}/include",
				"-o",
				"${workspaceFolder}/src/build_clang/data_structure_clang.exe"
			],
			"options": {
				"cwd": "${fileDirname}"
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": "build",
			"detail": "compiler: C:\\mingw64LLVM_Clang_LLD_LLDB\\bin\\clang.exe"
		},
		{
			"label": "Run Clang",
			"type": "shell",
			"command": "${workspaceFolder}/src/build_clang/data_structure_clang.exe",
			"group": {
				"kind": "test",
				"isDefault": true
			},
			"problemMatcher": []
		}
	]
}